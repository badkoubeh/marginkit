{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marginkit:schema:scorecard-v1",
  "title": "marginkit score card (v1)",
  "description": "A marginkit Scorecard: a collection of GridBreakPoint, Fit, Threshold and Ratio results plus provenance metadata. v1 is binomial-only: Fit.model accepts only \"binomial\", Fit.direction and Threshold.direction accept only \"decreasing\", and Ratio.dependence accepts only \"independent\". A new result family or enum value (ll4, isotonic, paired) is a schema_version \"2\" change, not a silent extension of this one. Each object's `properties` keys are kept in exact parity with its dataclass's field names (plus `type` for the five tagged result types) by tests/unit/test_report.py::TestSchemaFieldParity, so this file cannot silently drift from src/marginkit. additionalProperties is false everywhere: an unrecognised field is a reader/writer version mismatch, not a safe extension, in this schema version.",
  "type": "object",
  "properties": {
    "type": {
      "const": "Scorecard"
    },
    "results": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/GridBreakPoint"
          },
          {
            "$ref": "#/$defs/Fit"
          },
          {
            "$ref": "#/$defs/Threshold"
          },
          {
            "$ref": "#/$defs/Ratio"
          }
        ]
      }
    },
    "provenance": {
      "type": "object"
    },
    "created_at": {
      "type": "string"
    },
    "marginkit_version": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "results",
    "created_at",
    "marginkit_version",
    "schema_version"
  ],
  "additionalProperties": false,
  "$defs": {
    "GridBreakPoint": {
      "type": "object",
      "description": "marginkit.GridBreakPoint: the grid break-point rule's result (an observed statistic, not a fitted threshold).",
      "properties": {
        "type": {
          "const": "GridBreakPoint"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_tested": {
          "type": "number"
        },
        "censoring": {
          "$ref": "#/$defs/Censoring"
        },
        "schema_version": {
          "type": "string"
        },
        "provenance": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "value",
        "max_tested",
        "censoring"
      ],
      "additionalProperties": false
    },
    "Fit": {
      "type": "object",
      "description": "marginkit.Fit: a dose-response fit, or an explicit record of why one was not obtained. v1 is binomial-only: model accepts only \"binomial\" and direction accepts only \"decreasing\" (an increasing-is-worse definition is pending owner decision D5). params are on the natural scale, never the optimiser's reparametrisation.",
      "properties": {
        "type": {
          "const": "Fit"
        },
        "axis": {
          "$ref": "#/$defs/Axis"
        },
        "outcome": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "decreasing"
          ]
        },
        "model": {
          "enum": [
            "binomial"
          ]
        },
        "link": {
          "enum": [
            "probit",
            "logit",
            "cloglog"
          ]
        },
        "params": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "mu": {
                  "$ref": "#/$defs/Parameter"
                },
                "s": {
                  "$ref": "#/$defs/Parameter"
                },
                "upper": {
                  "$ref": "#/$defs/Parameter"
                },
                "lower": {
                  "$ref": "#/$defs/Parameter"
                }
              },
              "required": [
                "mu",
                "s",
                "upper",
                "lower"
              ],
              "additionalProperties": false
            }
          ]
        },
        "covariance": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Covariance"
            }
          ]
        },
        "log_likelihood": {
          "type": [
            "number",
            "null"
          ]
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cell"
          }
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "cluster_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "integer"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema_version": {
          "type": "string"
        },
        "provenance": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "axis",
        "outcome",
        "direction",
        "model",
        "link",
        "params",
        "covariance",
        "log_likelihood",
        "cells",
        "status"
      ],
      "additionalProperties": false
    },
    "Threshold": {
      "type": "object",
      "description": "marginkit.Threshold: where a fitted curve crosses a target performance, with a confidence interval, or an explicit record of why no value is reported. v1 direction accepts only \"decreasing\" (owner decision D5 pending for increasing-is-worse outcomes). Per-level trial counts live on fit.cells, not on a separate field.",
      "properties": {
        "type": {
          "const": "Threshold"
        },
        "axis": {
          "$ref": "#/$defs/Axis"
        },
        "definition": {
          "$ref": "#/$defs/Definition"
        },
        "direction": {
          "enum": [
            "decreasing"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "lo": {
          "type": [
            "number",
            "null"
          ]
        },
        "hi": {
          "type": [
            "number",
            "null"
          ]
        },
        "level": {
          "type": "number"
        },
        "interval_method": {
          "enum": [
            "profile",
            "delta",
            "exact_bound"
          ]
        },
        "censoring": {
          "$ref": "#/$defs/Censoring"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "dependence": {
          "enum": [
            "independent"
          ]
        },
        "fit": {
          "$ref": "#/$defs/Fit"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "baseline": {
          "description": "Set when status is FAILS_AT_BASELINE, null otherwise (decisions/0010). Appended in 0.1.0a3.",
          "oneOf": [
            {
              "$ref": "#/$defs/BaselineRate"
            },
            {
              "type": "null"
            }
          ]
        },
        "grid": {
          "description": "The grid break-point accompanying a SEPARATION/NOT_CONVERGED exact-bound fallback, null otherwise (decisions/0010). It is a grid statistic at grid resolution and is never the threshold value. Appended in 0.1.0a3.",
          "oneOf": [
            {
              "$ref": "#/$defs/GridBreakPoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "type": "string"
        },
        "provenance": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "axis",
        "definition",
        "direction",
        "value",
        "lo",
        "hi",
        "level",
        "interval_method",
        "censoring",
        "status",
        "dependence",
        "fit"
      ],
      "additionalProperties": false
    },
    "Ratio": {
      "type": "object",
      "description": "marginkit.Ratio: the ratio of two thresholds' severities, on the same axis, with a confidence interval. A failed or censored ratio (status != OK or censoring != NONE) carries shape=null, estimate=null, lo=null, hi=null -- no numbers. v1 dependence accepts only \"independent\" (v0.2 adds \"paired\").",
      "properties": {
        "type": {
          "const": "Ratio"
        },
        "threshold_a": {
          "$ref": "#/$defs/Threshold"
        },
        "threshold_b": {
          "$ref": "#/$defs/Threshold"
        },
        "estimate": {
          "type": [
            "number",
            "null"
          ]
        },
        "lo": {
          "type": [
            "number",
            "null"
          ]
        },
        "hi": {
          "type": [
            "number",
            "null"
          ]
        },
        "shape": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/IntervalShape"
            }
          ]
        },
        "method": {
          "enum": [
            "fieller",
            "log_delta"
          ]
        },
        "dependence": {
          "enum": [
            "independent"
          ]
        },
        "level": {
          "type": "number"
        },
        "censoring": {
          "$ref": "#/$defs/Censoring"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema_version": {
          "type": "string"
        },
        "provenance": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "threshold_a",
        "threshold_b",
        "estimate",
        "lo",
        "hi",
        "shape",
        "method",
        "dependence",
        "level",
        "censoring",
        "status"
      ],
      "additionalProperties": false
    },
    "Axis": {
      "type": "object",
      "description": "marginkit.Axis: the severity axis a series of observations was measured on.",
      "properties": {
        "name": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "scale": {
          "enum": [
            "log",
            "linear"
          ]
        },
        "citation": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "unit",
        "scale"
      ],
      "additionalProperties": false
    },
    "Definition": {
      "type": "object",
      "description": "marginkit.Definition: which target performance a threshold solves for.",
      "properties": {
        "kind": {
          "enum": [
            "absolute",
            "baseline_fraction",
            "relative"
          ]
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "Cell": {
      "type": "object",
      "description": "marginkit.Cell: one pooled row of counts at a single severity.",
      "properties": {
        "severity": {
          "type": "number"
        },
        "successes": {
          "type": "integer"
        },
        "trials": {
          "type": "integer"
        }
      },
      "required": [
        "severity",
        "successes",
        "trials"
      ],
      "additionalProperties": false
    },
    "Parameter": {
      "type": "object",
      "description": "marginkit.Parameter: one fitted or fixed parameter value, on the natural scale (never the optimiser's log/logit reparametrisation).",
      "properties": {
        "value": {
          "type": "number"
        },
        "fixed": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "fixed"
      ],
      "additionalProperties": false
    },
    "Covariance": {
      "type": "object",
      "description": "marginkit.Covariance: the variance-covariance matrix of a fit's estimated (non-fixed) parameters, on the natural scale. Positive semi-definite.",
      "properties": {
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matrix": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      },
      "required": [
        "names",
        "matrix"
      ],
      "additionalProperties": false
    },
    "Censoring": {
      "type": "string",
      "enum": [
        "NONE",
        "RIGHT",
        "LEFT",
        "OPEN_UPPER",
        "OPEN_LOWER"
      ]
    },
    "Status": {
      "type": "string",
      "enum": [
        "OK",
        "SEPARATION",
        "NOT_CONVERGED",
        "UNREACHABLE",
        "FAILS_AT_BASELINE",
        "CONTROL_INCOMPATIBLE"
      ]
    },
    "IntervalShape": {
      "type": "string",
      "enum": [
        "BOUNDED",
        "UNBOUNDED",
        "EXCLUSIVE"
      ]
    },
    "BaselineRate": {
      "type": "object",
      "description": "marginkit.BaselineRate: the control cell's observed rate with its exact (Clopper-Pearson) interval, reported when a Threshold's status is FAILS_AT_BASELINE (plan section 5.5, decisions/0010). An untagged helper, like Cell: it appears only as Threshold.baseline. Its lo/hi are a per-cell exact interval and are deliberately NOT a threshold interval -- plan section 5.4 forbids attaching Clopper-Pearson to a threshold, which is why these live here and never in Threshold.lo/.hi.",
      "properties": {
        "severity": {
          "type": "number"
        },
        "successes": {
          "type": "integer"
        },
        "trials": {
          "type": "integer"
        },
        "rate": {
          "type": "number"
        },
        "lo": {
          "type": "number"
        },
        "hi": {
          "type": "number"
        },
        "level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "method": {
          "type": "string",
          "const": "per_cell_clopper_pearson"
        }
      },
      "required": [
        "severity",
        "successes",
        "trials",
        "rate",
        "lo",
        "hi"
      ],
      "additionalProperties": false
    }
  }
}
